# Copy this file to `.env.local`.
#   Copy-Item .env.local.example .env.local   (Windows PowerShell)
#   cp .env.local.example .env.local           (macOS/Linux)

# HTTP API goes through the Next.js proxy (/api -> backend on :3000).
NEXT_PUBLIC_API_URL=/api

# WebSocket URL is auto-detected (see src/lib/wsUrl.ts): direct to the backend
# when opened on :3001, or same-origin when behind the share proxy / ngrok.
# Only set this to force a specific backend WebSocket URL.
NEXT_PUBLIC_WS_URL=
