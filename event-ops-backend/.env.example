# Copy this file to `.env` and fill in the values.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)

# ── Database (matches docker-compose.yml) ───────────────────────────
# These are LOCAL/DEMO defaults. Use strong, unique credentials in production
# and do not expose Postgres publicly.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=event_ops

# ── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production (the app refuses to start without it there). Generate a
# long random value, e.g. `openssl rand -hex 32`. The placeholder below is for
# local development only — change it.
JWT_SECRET=dev_local_secret_change_me

# ── CORS / origins ──────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API and open a
# WebSocket. Defaults to the dev frontend. FRONTEND_ORIGIN scopes the Socket.io
# CORS specifically (defaults to the first/only dev origin).
CORS_ORIGIN=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001

# ── AI (optional) ───────────────────────────────────────────────────
# The AI Assistant talks to any OpenAI-compatible chat-completions API.
# Fill in the three AI_* lines for your provider. Leave AI_API_KEY blank to
# disable the AI entirely (everything else still works). AI_BASE_URL and
# AI_MODEL default to DeepSeek when omitted.
# Optional: AI_JSON_MODE=off disables the strict JSON request for a provider that
# rejects it (the app also auto-retries without it on a 400/422).
#
# Provider examples (set the same three vars):
#   Gemini (free, no card): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
#   DeepSeek:               AI_BASE_URL=https://api.deepseek.com/v1        AI_MODEL=deepseek-chat
#   OpenAI:                 AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o-mini
#   Groq:                   AI_BASE_URL=https://api.groq.com/openai/v1     AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:             AI_BASE_URL=https://openrouter.ai/api/v1       AI_MODEL=<a :free model>
#   Local (Ollama):         AI_BASE_URL=http://localhost:11434/v1          AI_MODEL=llama3.1
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
