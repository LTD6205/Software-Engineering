# Copy to `.env` on the EC2 instance and replace every production secret.

# Public origin for CORS and WebSocket origin checks.
# Use the EC2 public IP for a quick demo, or your domain when DNS is ready.
PUBLIC_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# PostgreSQL credentials used by the internal Compose database.
DB_USERNAME=postgres
DB_PASSWORD=change_this_database_password
DB_NAME=event_ops

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_value

# Optional. Leave AI_API_KEY blank to disable the AI Assistant.
# The backend supports any OpenAI-compatible chat-completions API.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Backward-compatible fallback for older local setups.
DEEPSEEK_API_KEY=
