# Copy to .env in this folder, then fill in the values:
#   cp .env.example .env   &&   nano .env
# (deploy/.env is gitignored — never commit real secrets.)

# Public URL the browser uses to reach the app. For HTTP on a bare EC2 IP:
#   PUBLIC_URL=http://<YOUR_EC2_PUBLIC_IP>
# (no trailing slash; include http://)
PUBLIC_URL=http://CHANGE_ME

# Postgres password for the in-container database. Use a strong value.
POSTGRES_PASSWORD=change_me_to_a_strong_db_password

# REQUIRED. The backend refuses to start in production without it.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# ── AI Assistant (optional) ────────────────────────────────────────────────
# Leave AI_API_KEY blank to disable the assistant (everything else still works).
# Free option without a credit card: Google Gemini (defaults below).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
